<?xml version="1.0"?>
<ruleset name="Slim4StarterPack">
    <description>Coding standard configuration for the Slim 4 Starter Pack.</description>

    <file>src</file>
    <file>bin</file>
    <file>db</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="p"/>
    <arg name="warning-severity" value="0"/>
    <arg name="cache" value=".phpcs.cache"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>

    <rule ref="PSR12"/>
    <!-- Phinx migrations are framework-loaded global classes and cannot be namespaced. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>*/db/migrations/*</exclude-pattern>
    </rule>
</ruleset>
