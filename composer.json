{
    "name": "nerdv2/slim4-skeleton",
    "description": "Slim 4 Skeleton",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "aws/aws-sdk-php": "^3.306",
        "lcobucci/clock": "^3.0",
        "lcobucci/jwt": "^5.0",
        "monolog/monolog": "^3.6",
        "pecee/pixie": "^4.15",
        "pimple/pimple": "^3.2",
        "predis/predis": "^1.1",
        "robmorgan/phinx": "^0.15.5",
        "selective/basepath": "^2.1",
        "slim/psr7": "^1.0.0",
        "slim/slim": "^4.8",
        "slim/twig-view": "^3.2",
        "twig/intl-extra": "^3.5",
        "vlucas/phpdotenv": "^5.1",
        "zircote/swagger-php": "^4.8"
    },
    "config": {
        "platform": {
            "php": "8.3.10"
        },
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": [
            "php -S localhost:8080 -t public"
        ],
        "generate-openapi-docs": [
            "./vendor/bin/openapi src/Controller -o public/openapi.yaml",
            "./vendor/bin/openapi src/Controller --format json -o public/openapi.json"
        ],
        "migrate": [
            "./vendor/bin/phinx migrate"
        ],
        "migrate:rollback": [
            "./vendor/bin/phinx rollback"
        ],
        "seed": [
            "./vendor/bin/phinx seed:run"
        ]
    }
}
