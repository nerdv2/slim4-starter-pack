{
    "name": "nerdv2/slim4-skeleton",
    "description": "Slim 4 Skeleton",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "aws/aws-sdk-php": "^3.306",
        "lcobucci/clock": "^3.0",
        "lcobucci/jwt": "^5.0",
        "monolog/monolog": "^3.6",
        "oeltimacreation/php-simplequery": "^0.6",
        "pimple/pimple": "^3.2",
        "predis/predis": "^1.1",
        "robmorgan/phinx": "^0.15.5",
        "selective/basepath": "^2.1",
        "sentry/sentry": "^4.31",
        "slim/psr7": "^1.0.0",
        "slim/slim": "^4.8",
        "slim/twig-view": "^3.2",
        "symfony/dotenv": "^7.4",
        "twig/intl-extra": "^3.5",
        "zircote/swagger-php": "^6.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "fakerphp/faker": "^1.24",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.3.10"
        },
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "php -S localhost:8080 -t public"
        ],
        "generate-openapi-docs": [
            "./vendor/bin/openapi src/Controller -o public/openapi.yaml",
            "./vendor/bin/openapi src/Controller --format json -o public/openapi.json"
        ],
        "migrate": [
            "./vendor/bin/phinx migrate"
        ],
        "migrate:rollback": [
            "./vendor/bin/phinx rollback"
        ],
        "seed": [
            "./vendor/bin/phinx seed:run"
        ],
        "token": [
            "php bin/generate-token"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse --no-progress"
        ],
        "phpcs": [
            "./vendor/bin/phpcs"
        ],
        "phpcbf": [
            "./vendor/bin/phpcbf"
        ],
        "check": [
            "@composer validate --no-check-publish",
            "@analyse",
            "@phpcs"
        ],
        "test": [
            "./vendor/bin/phpunit"
        ],
        "test-unit": [
            "./vendor/bin/phpunit --testsuite=Unit"
        ],
        "test-integration": [
            "./vendor/bin/phpunit --testsuite=Integration"
        ]
    }
}
