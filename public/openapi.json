    "paths": {
        "/customer": {
            "get": {
                "tags": [
                    "Customer"
                ],
                "summary": "List customers",
                "description": "Retrieve a paginated customer list with optional keyword search.",
                "operationId": "40b7f7503eba97a0c6399d9ef21c7e12",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number (1-based)",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Rows per page (max 100)",
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "keywords",
                        "in": "query",
                        "description": "Case-insensitive name search",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                }
            }
        },
        "/customer/add": {
            "post": {
                "tags": [
                    "Customer"
                ],
                "summary": "Create customer",
                "description": "Create a customer. Requires an admin token.",
                "operationId": "867eea20c068a227fbe1205518f2e61d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Customer name",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "400": {
                        "description": "Validation failed"
                    },
                    "401": {
                        "description": "Missing or invalid token"
                    },
                    "403": {
                        "description": "Access denied"
                    }
                },
                "security": [
                    {
                        "auth_token": []
                    }
                ]
            }
        },
