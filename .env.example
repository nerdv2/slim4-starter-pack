# =============================================================================
# Application
# =============================================================================
APP_NAME="Customer DB"
APP_VERSION="dev"
APP_ENVIRONMENT="development"
DEFAULT_TIMEZONE="Asia/Jakarta"
APP_BASE_URL="http://localhost:8080"
APP_KEY="please-change-my-value-to-secure-app"

# =============================================================================
# Runtime
# =============================================================================
# Detailed error output; never enable in production.
DISPLAY_ERROR_DETAILS=true
# Compiled route cache: empty keeps it enabled unless DISPLAY_ERROR_DETAILS is true.
ROUTE_CACHE=
# URL base path when the API is served from a sub-directory; leave empty otherwise.
SLIM_BASH_PATH=

# =============================================================================
# Uploads
# =============================================================================
DEFAULT_UPLOAD_TARGET="filesystem"
# Customer avatar upload limit in bytes and the allowed extensions.
UPLOAD_AVATAR_MAX_BYTES=2097152
UPLOAD_AVATAR_EXTENSIONS="jpg,jpeg,png,webp"
# Customer CSV import limit in bytes.
UPLOAD_IMPORT_MAX_BYTES=5242880

# =============================================================================
# JWT
# =============================================================================
# HMAC-SHA256 signing secret, minimum 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=
# JWT ID (jti) claim; leave empty to use the application default.
JWT_IDENTIFIER=
# Access token lifetime, strtotime compatible. Keep it short: refresh tokens
# (opaque, hashed and rotated in the database) restore the session.
JWT_ACCESS_TTL="+15 minute"
# Lifetime used by bin/generate-token for local development tokens.
JWT_TTL="+7 day"

# =============================================================================
# Authentication cookies
# =============================================================================
# Refresh token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie SameSite policy: Lax, Strict or None. None requires Secure.
AUTH_COOKIE_SAMESITE=Lax
# Force the Secure flag on auth cookies; leave empty to derive it from APP_ENVIRONMENT.
AUTH_COOKIE_SECURE=

# =============================================================================
# Database
# =============================================================================
# Supported drivers: mysql, mariadb, sqlite.
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Read replica (optional); each value falls back to its primary counterpart when empty.
DB_HOST_READ=
DB_PORT_READ=
DB_USER_READ=
DB_PASS_READ=
DB_NAME_READ=

# =============================================================================
# CORS (development only; production CORS is handled by the webserver/proxy)
# =============================================================================
CORS_ENABLED=true
# Comma-separated exact origins; empty means wildcard (no credentials).
# The Vue dev server defaults to http://localhost:5173.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
# Credentials are required for the HttpOnly refresh cookie, and the browser
# refuses credentialed requests against a wildcard origin.
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_HEADERS="X-Requested-With, X-Client-Type, Content-Type, Accept, Origin, Authorization"
CORS_ALLOWED_METHODS="GET, POST, PUT, DELETE, PATCH, OPTIONS"
CORS_MAX_AGE=86400

# =============================================================================
# Background queue
# =============================================================================
# Driver: auto (database fallback), database or redis.
QUEUE_DRIVER=auto
QUEUE_REDIS_PREFIX=slim4
JOB_RETRY_BASE_DELAY_SECONDS=2
JOB_RETRY_MAX_DELAY_SECONDS=300
JOB_STUCK_TTL_SECONDS=900
JOB_POLL_TIMEOUT_SECONDS=5
JOB_MAX_JOBS=500
JOB_MAX_TIME_SECONDS=3600
JOB_MEMORY_LIMIT_BYTES=268435456
JOB_PROMOTE_INTERVAL_SECONDS=5
JOB_PROMOTE_LIMIT=100
JOB_RECOVERY_INTERVAL_SECONDS=60

# =============================================================================
# Observability
# =============================================================================
# Sentry DSN; leave empty to disable error reporting.
SENTRY_DSN=
# Token for GET /health/detailed; development and testing bypass it when empty.
HEALTHCHECK_TOKEN=

# =============================================================================
# Redis (optional; used for caching)
# =============================================================================
REDIS_SERVER_HOST=
REDIS_SERVER_PORT=6379
REDIS_SERVER_PASSWORD=
REDIS_SERVER_DATABASE=0
# Key prefix; use a different value per environment when Redis is shared.
REDIS_SERVER_PREFIX="v1:"

# =============================================================================
# Object storage (S3-compatible; used when DEFAULT_UPLOAD_TARGET=s3)
# =============================================================================
S3_ENDPOINT=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_CDN_DOMAIN=
